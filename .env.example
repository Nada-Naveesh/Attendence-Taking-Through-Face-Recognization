# Application Settings
APP_NAME="Smart Attendance & Analytics AI Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Database Configuration (SQLite for local dev, migrateable to PostgreSQL + pgvector)
DATABASE_URL="sqlite:///./data/attendance.db"

# Computer Vision & Deep Learning Configuration
DETECTOR_BACKEND="yolov8"  # Options: yolov8, mtcnn, haar
DETECTION_CONFIDENCE=0.50
RECOGNITION_MODEL="Facenet512"  # Options: Facenet512, ArcFace, VGG-Face
DISTANCE_METRIC="cosine"  # Options: cosine, euclidean
SIMILARITY_THRESHOLD=0.68  # Minimum cosine similarity for positive face match

# Liveness & Anti-Spoofing Detection Configuration
EAR_THRESHOLD=0.25  # Eye Aspect Ratio threshold below which an eye is deemed closed
EAR_CONSECUTIVE_FRAMES=3  # Consecutive frames below threshold required to register a blink
LIVENESS_WINDOW_SECONDS=3.0  # Max time allowed to perform blink challenge

# CORS & Frontend Origins
ALLOWED_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501", "http://localhost:3000"]
